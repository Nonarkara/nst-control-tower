# SPA routes that share a path prefix with a static directory (public/data/…).
# Exact matches only — /data/workbench/*.json must still be served as files.
# Rewrite to "/" (not "/index.html"): Pages 308-redirects /index.html → /,
# which turned /data into a redirect to the map instead of a rewrite.
/data   /   200
/data/  /   200
# /research is an SPA route that shares its prefix with public/research/*.pdf.
/research   /   200
/research/  /   200
