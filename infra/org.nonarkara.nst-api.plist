<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.nonarkara.nst-api</string>

    <key>WorkingDirectory</key>
    <string>__NST_ROOT__/apps/api</string>

    <!-- Run through a login shell (bash -l) so the daemon inherits the full user
         environment the pnpm shim needs. Replace __NST_ROOT__ with the checkout
         and __PNPM_BIN_DIR__ with the directory that contains pnpm. Do not commit
         a real home directory. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-l</string>
        <string>__NST_ROOT__/infra/run-nst-api.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:__PNPM_BIN_DIR__</string>
        <key>NST_ROOT</key>
        <string>__NST_ROOT__</string>
        <key>HOST</key>
        <string>127.0.0.1</string>
        <key>PORT</key>
        <string>8794</string>
        <key>ENVIRONMENT</key>
        <string>production</string>
        <!-- Provider keys belong in the untracked LaunchAgents copy, not here. -->
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__NST_ROOT__/var/api.out.log</string>
    <key>StandardErrorPath</key>
    <string>__NST_ROOT__/var/api.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
